        {
            "type": "cppbuild",
            //"type": "shell",
            "label": "C/C++: g++.exe build active file",
            "command": "cl.exe",
            "args": [
                "/std:c++latest",
                "/nologo",
                "/EHsc",
                "/Zi",
                "/O0", //just like we were taught in assembly, O3 = most optimized, O0 = least optimized (good for debugging)
                "/W4",
                "/I",
                "C:\\gurobi1300\\win64\\include",
                "/Fe:",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}",
                "C:\\gurobi1300\\win64\\lib\\gurobi_c++mt2017.lib",
                "C:\\gurobi1300\\win64\\lib\\gurobi130.lib",
                "/link",
                "/MACHINE:X64"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"

   
